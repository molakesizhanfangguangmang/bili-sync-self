diff --git a/crates/bili_sync/src/api/routes/dashboard_layout/mod.rs b/crates/bili_sync/src/api/routes/dashboard_layout/mod.rs
new file mode 100644
index 0000000..026ab3b
--- /dev/null
+++ b/crates/bili_sync/src/api/routes/dashboard_layout/mod.rs
@@ -0,0 +1,88 @@
+use std::collections::HashSet;
+use std::path::PathBuf;
+
+use anyhow::{Context, Result};
+use axum::Router;
+use axum::routing::get;
+use serde::{Deserialize, Serialize};
+use tracing::warn;
+use validator::Validate;
+
+use crate::api::error::InnerApiError;
+use crate::api::wrapper::{ApiError, ApiResponse, ValidatedJson};
+use crate::config::CONFIG_DIR;
+
+/// 仪表盘认得的板块 id，别的 id 一律拒绝
+pub const DASHBOARD_BLOCKS: [&str; 9] = [
+    "disk", "sources", "recent", "task", "memory", "cpu", "net", "queue", "library",
+];
+
+/// 没有配置文件时的默认板块与顺序
+const DEFAULT_BLOCKS: [&str; 9] = [
+    "disk", "sources", "recent", "task", "memory", "cpu", "net", "queue", "library",
+];
+
+/// 仪表盘板块配置，存在配置文件里，换浏览器仍然生效
+#[derive(Serialize, Deserialize, Clone, Validate)]
+pub struct DashboardLayout {
+    pub blocks: Vec<String>,
+}
+
+impl Default for DashboardLayout {
+    fn default() -> Self {
+        Self {
+            blocks: DEFAULT_BLOCKS.iter().map(|block| block.to_string()).collect(),
+        }
+    }
+}
+
+pub(super) fn router() -> Router {
+    Router::new().route("/dashboard-layout", get(get_layout).put(update_layout))
+}
+
+fn layout_path() -> PathBuf {
+    CONFIG_DIR.join("dashboard-layout.json")
+}
+
+async fn get_layout() -> Result<ApiResponse<DashboardLayout>, ApiError> {
+    Ok(ApiResponse::ok(load_layout().await?))
+}
+
+async fn update_layout(
+    ValidatedJson(layout): ValidatedJson<DashboardLayout>,
+) -> Result<ApiResponse<DashboardLayout>, ApiError> {
+    // 去重 + 去空白，顺带挡住不认识的板块 id
+    let mut seen = HashSet::new();
+    let blocks = layout
+        .blocks
+        .iter()
+        .map(|block| block.trim().to_owned())
+        .filter(|block| seen.insert(block.clone()))
+        .collect::<Vec<_>>();
+    if let Some(unknown) = blocks.iter().find(|block| !DASHBOARD_BLOCKS.contains(&block.as_str())) {
+        return Err(InnerApiError::BadRequest(format!("未知的仪表盘板块：{unknown}")).into());
+    }
+    let layout = DashboardLayout { blocks };
+    let path = layout_path();
+    let data = serde_json::to_vec_pretty(&layout).context("序列化仪表盘板块配置失败")?;
+    tokio::fs::write(&path, data)
+        .await
+        .with_context(|| format!("写入 {} 失败", path.display()))?;
+    Ok(ApiResponse::ok(layout))
+}
+
+async fn load_layout() -> Result<DashboardLayout> {
+    let path = layout_path();
+    match tokio::fs::read(&path).await {
+        Ok(data) => match serde_json::from_slice::<DashboardLayout>(&data) {
+            Ok(layout) => Ok(layout),
+            // 配置坏了不至于让仪表盘打不开，退回默认顺序
+            Err(e) => {
+                warn!("读取 {} 失败，改用默认板块：{e:?}", path.display());
+                Ok(DashboardLayout::default())
+            }
+        },
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(DashboardLayout::default()),
+        Err(e) => Err(e).with_context(|| format!("读取 {} 失败", path.display())),
+    }
+}
