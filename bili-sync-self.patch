+<script lang="ts">
+	import { setBreadcrumb } from '$lib/stores/breadcrumb';
+	import { onMount } from 'svelte';
+
+	// steward（核盘 / 文件 / 下载列表）跑在同一个容器里，映射到宿主机 12346 端口。
+	// 用当前访问的主机名拼地址，从局域网 IP 或 localhost 打开都能用。
+	// iframe 是另一个源，读不到本页的主题，所以把当前明暗当查询参数带过去，
+	// 那边认 ?theme=dark|light（不带参数时按它自己的系统偏好）。
+	let src = '';
+
+	onMount(() => {
+		setBreadcrumb([{ label: '存储' }]);
+		const theme = () => (document.documentElement.classList.contains('dark') ? 'dark' : 'light');
+		const url = () => `${location.protocol}//${location.hostname}:12346/?theme=${theme()}`;
+		src = url();
+		// 页面上切明暗时把新主题重新带过去（换 src 会让 iframe 重载一次，切换不常发生，可以接受）
+		const observer = new MutationObserver(() => {
+			src = url();
+		});
+		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
+		return () => observer.disconnect();
+	});
+</script>
+
+<svelte:head>
+	<title>存储 - Bili Sync</title>
+</svelte:head>
+
+{#if src}
+	<iframe
+		{src}
+		title="steward"
+		class="bg-background h-[calc(100vh-7rem)] w-full rounded-lg border"
+	></iframe>
+{/if}
