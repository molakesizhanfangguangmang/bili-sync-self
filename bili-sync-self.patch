     }
 }
+
+/// 采样网卡速率，返回（接收、发送）的字节/秒。
+/// 读 /proc/net/dev 里的累计字节数与上一次采样做差再除以间隔，回环网卡不计；
+/// 第一次调用只记基线，返回 (0, 0)。
+#[cfg(target_os = "linux")]
+fn sample_net_speed(baseline: &mut Option<(u64, u64, Instant)>) -> (u64, u64) {
+    let Ok(content) = std::fs::read_to_string("/proc/net/dev") else {
+        return (0, 0);
+    };
+    let (rx, tx) = content
+        .lines()
+        .skip(2) // 前两行是表头
+        .filter_map(|line| {
+            let (name, rest) = line.split_once(':')?;
+            if name.trim() == "lo" {
+                return None;
+            }
+            let mut fields = rest.split_whitespace();
+            let rx = fields.next()?.parse::<u64>().ok()?;
+            // 收包 8 个字段之后才是发包的字节数
+            let tx = fields.nth(7)?.parse::<u64>().ok()?;
+            Some((rx, tx))
+        })
+        .fold((0, 0), |(rx, tx), (item_rx, item_tx)| (rx + item_rx, tx + item_tx));
+    let now = Instant::now();
+    let speed = match baseline {
+        Some((last_rx, last_tx, last_at)) => {
+            let elapsed = now.duration_since(*last_at).as_secs_f64();
+            if elapsed <= 0.0 {
+                (0, 0)
+            } else {
+                (
+                    (rx.saturating_sub(*last_rx) as f64 / elapsed) as u64,
+                    (tx.saturating_sub(*last_tx) as f64 / elapsed) as u64,
+                )
+            }
+        }
+        None => (0, 0),
+    };
+    *baseline = Some((rx, tx, now));
+    speed
+}
+
+/// 非 linux 平台拿不到 /proc/net/dev，直接给 0
+#[cfg(not(target_os = "linux"))]
+fn sample_net_speed(baseline: &mut Option<(u64, u64, Instant)>) -> (u64, u64) {
+    let _ = baseline;
+    (0, 0)
+}
