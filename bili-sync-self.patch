+/// 找到视频所属的视频源：手动下载单条视频时需要用它来定位保存目录与过滤规则
+async fn find_video_source(video_model: &video::Model, connection: &DatabaseConnection) -> Result<VideoSourceEnum> {
+    if let Some(id) = video_model.favorite_id
+        && let Some(source) = favorite::Entity::find_by_id(id).one(connection).await?
+    {
+        return Ok(VideoSourceEnum::from(source));
+    }
+    if let Some(id) = video_model.collection_id
+        && let Some(source) = collection::Entity::find_by_id(id).one(connection).await?
+    {
+        return Ok(VideoSourceEnum::from(source));
+    }
+    if let Some(id) = video_model.submission_id
+        && let Some(source) = submission::Entity::find_by_id(id).one(connection).await?
+    {
+        return Ok(VideoSourceEnum::from(source));
+    }
+    if let Some(id) = video_model.watch_later_id
+        && let Some(source) = watch_later::Entity::find_by_id(id).one(connection).await?
+    {
+        return Ok(VideoSourceEnum::from(source));
+    }
+    bail!(
+        "视频「{}」（{}）没有可用的视频来源，无法下载",
+        video_model.name,
+        video_model.bvid
+    )
+}
+
+/// 手动下载单个视频：不扫描整轮，只把这一条下下来。
+/// 这条还没填充分页时（例如刚被清空重置过）先补一次详情，再走正常的下载流程。
+pub async fn download_single_video(
+    video_id: i32,
+    bili_client: &BiliClient,
+    connection: &DatabaseConnection,
+    config: &Config,
+) -> Result<()> {
+    config.check().context("配置检查失败")?;
+    // 下载分页依赖全局的 wbi mixin key，正常轮次里由下载任务设置，这里手动补一次
+    let mixin_key = bili_client
+        .wbi_img(&config.credential)
+        .await
+        .context("获取 wbi_img 失败")?
+        .into_mixin_key()
+        .context("解析 mixin key 失败")?;
+    crate::bilibili::set_global_mixin_key(mixin_key);
+    let Some(mut video_model) = video::Entity::find_by_id(video_id).one(connection).await? else {
+        bail!("视频 {} 已不在库中，跳过下载", video_id);
+    };
+    ensure!(video_model.valid, "视频「{}」已失效，跳过下载", video_model.name);
+    let video_source = find_video_source(&video_model, connection).await?;
+    if video_model.single_page.is_none() {
+        fetch_video_details(bili_client, &video_source, connection, config).await?;
+        video_model = video::Entity::find_by_id(video_id)
+            .one(connection)
+            .await?
+            .context("视频在填充详情后从库中消失")?;
+    }
+    let pages_model = page::Entity::find()
+        .filter(page::Column::VideoId.eq(video_id))
+        .order_by_asc(page::Column::Cid)
+        .all(connection)
+        .await?;
+    ensure!(!pages_model.is_empty(), "视频「{}」没有可下载的分页", video_model.name);
+    let template = TEMPLATE.snapshot();
+    let downloader = Downloader::new(bili_client.client.clone());
+    let source_filter_option = video_source
+        .filter_option()
+        .as_ref()
+        .map(|value| serde_json::from_value(value.clone()))
+        .transpose()?;
+    let filter_option = source_filter_option.as_ref().unwrap_or(&config.filter_option);
+    let cx = DownloadContext::new(
+        bili_client,
+        &video_source,
+        &template,
+        connection,
+        &downloader,
+        config,
+        filter_option,
+    );
+    let task_uids = video_model.uppers().map(|upper| upper.mid).collect::<Vec<_>>();
+    info!("开始手动下载视频「{}」（{}）", video_model.name, video_model.bvid);
+    let video_active_model = download_video_pages(video_model, pages_model, task_uids, cx).await?;
+    update_videos_model(vec![video_active_model], connection).await?;
+    Ok(())
+}
