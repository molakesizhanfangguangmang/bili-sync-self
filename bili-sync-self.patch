+<script lang="ts">
+	import { setBreadcrumb } from '$lib/stores/breadcrumb';
+	import { onMount } from 'svelte';
+
+	// steward（核盘 / 文件 / 下载列表）跑在同一个容器里，映射到宿主机 12346 端口。
+	// 用当前访问的主机名拼地址，从局域网 IP 或 localhost 打开都能用。
+	let src = '';
+
+	onMount(() => {
+		setBreadcrumb([{ label: '存储' }]);
+		src = `${location.protocol}//${location.hostname}:12346/`;
+	});
+</script>
+
+<svelte:head>
+	<title>存储 - Bili Sync</title>
+</svelte:head>
+
+{#if src}
+	<iframe
+		{src}
+		title="steward"
+		class="bg-background h-[calc(100vh-7rem)] w-full rounded-lg border"
+	></iframe>
+{/if}
