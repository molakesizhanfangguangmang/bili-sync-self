+/// 「立即下载」：把这一条塞进下载队列，跟队列顺序走，不等下一轮 interval，也不抢占正在跑的任务。
+///
+/// 同一个 bvid 已经有下载完成的一份时，先回 already_exists 让前端问一句，
+/// 用户确认覆盖后带 overwrite 再来一次：先清空重置「有文件的那条」（删文件夹、状态归零），再只下这一条。
+pub async fn download_video_now(
+    Path(id): Path<i32>,
+    Extension(db): Extension<DatabaseConnection>,
+    Json(request): Json<DownloadVideoRequest>,
+) -> Result<ApiResponse<DownloadVideoResponse>, ApiError> {
+    let Some(video_model) = video::Entity::find_by_id(id).one(&db).await? else {
+        return Err(InnerApiError::NotFound(id).into());
+    };
+    if !video_model.valid {
+        return Ok(ApiResponse::ok(DownloadVideoResponse {
+            status: DownloadVideoStatus::Invalid,
+            warning: None,
+            video: to_video_info(&video_model),
+        }));
+    }
+    // 同一 bvid 有没有已经下载完成的一份（完成标记是 download_status 的最高位）
+    let completed_exists = video::Entity::find()
+        .filter(video::Column::Bvid.eq(video_model.bvid.as_str()))
+        .filter(video::Column::DownloadStatus.gte(STATUS_COMPLETED))
+        .count(&db)
+        .await?
+        > 0;
+    if completed_exists && !request.overwrite {
+        return Ok(ApiResponse::ok(DownloadVideoResponse {
+            status: DownloadVideoStatus::AlreadyExists,
+            warning: None,
+            video: to_video_info(&video_model),
+        }));
+    }
+    let mut target = video_model;
+    let mut warning = None;
+    if completed_exists {
+        // 覆盖重下：以「有文件的那条」为准清空重置，避免留下孤儿文件夹
+        let completed = video::Entity::find()
+            .filter(video::Column::Bvid.eq(target.bvid.as_str()))
+            .filter(video::Column::DownloadStatus.gte(STATUS_COMPLETED))
+            .order_by_asc(video::Column::Id)
+            .one(&db)
+            .await?;
+        if let Some(completed) = completed {
+            let (cleared, clear_warning) = clear_and_reset_video(&db, completed.id).await?;
+            warning = clear_warning;
+            target = cleared;
+        }
+    }
+    DownloadTaskManager::get().download_video_once(target.id).await?;
+    Ok(ApiResponse::ok(DownloadVideoResponse {
+        status: DownloadVideoStatus::Enqueued,
+        warning,
+        video: to_video_info(&target),
+    }))
+}
