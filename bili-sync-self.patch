+	let coverFailed = false;
+	let avatarFailed = false;
+	let introExpanded = false;
+	let lightboxOpen = false;
+
+	// 封面/头像都是 B 站 CDN 地址：CDN 认得外站 Referer 会回 403，所以图片都要带
+	// referrerpolicy="no-referrer"，顺手把 http 归一成 https。
+	$: coverUrl = (video.cover ?? '').replace(/^http:/, 'https:');
+	$: avatarUrl = (video.upper_face ?? '').replace(/^http:/, 'https:');
+
+	// ---------- 格式化 ----------
+
+	// B 站那边就把简介转义过一轮，所以库里存的是 `&amp;` 这种。这里只解一轮：
+	// `&amp;` → `&`、`&lt;` → `<`、`:&lt;` → `:<`。不递归，免得把作者自己写的
+	// `&amp;` 文案再解一次。输出一律走 Svelte 文本插值（默认转义），没有 {@html}。
+	const ENTITIES: Record<string, string> = {
+		'&amp;': '&',
+		'&lt;': '<',
+		'&gt;': '>',
+		'&quot;': '"',
+		'&#39;': "'",
+		'&apos;': "'",
+		'&nbsp;': ' '
+	};
+
+	function decodeEntitiesOnce(text: string): string {
+		return text.replace(/&(?:amp|lt|gt|quot|#39|apos|nbsp);/g, (match) => ENTITIES[match] ?? match);
+	}
+
+	/** 简介：换行与不换行空格归一、只解一轮实体；空或 `-` 当没有。 */
+	function normalizeIntro(raw: string | null | undefined): string | null {
+		if (!raw) {
+			return null;
+		}
+		const text = decodeEntitiesOnce(raw.replace(/\r\n?/g, '\n').replace(/\u00a0/g, ' ')).trim();
+		if (!text || text === '-') {
+			return null;
+		}
+		return text;
+	}
+
+	/** 联合投稿：正常是数组（后端已经解析过）；万一给的是 JSON 字符串也兜一下。 */
+	function normalizeStaff(raw: unknown): StaffMember[] {
+		let list: unknown = raw;
+		if (typeof raw === 'string') {
+			try {
+				list = JSON.parse(raw);
+			} catch {
+				return [];
+			}
+		}
+		if (!Array.isArray(list)) {
+			return [];
+		}
+		return list.filter(
+			(member): member is StaffMember =>
+				!!member && typeof member === 'object' && typeof (member as StaffMember).name === 'string'
+		);
+	}
+
+	/** 库里存的是 UTC 的 naive 时间（后端写的是 naive_utc()），没带时区后缀，补个 Z 再按本地时区显示。 */
+	function formatMoment(raw: string | null | undefined): string | null {
+		if (!raw) {
+			return null;
+		}
+		const iso = /(?:Z|[+-]\d{2}:?\d{2})$/.test(raw) ? raw : `${raw}Z`;
+		const date = new Date(iso);
+		if (Number.isNaN(date.getTime()) || date.getFullYear() < 2000) {
+			return null;
+		}
+		return date.toLocaleString('zh-CN', { hour12: false });
+	}
+
+	/** 时长：各分页加起来。 */
+	function formatDuration(seconds: number): string | null {
+		if (!seconds || seconds <= 0) {
+			return null;
+		}
+		const hours = Math.floor(seconds / 3600);
+		const minutes = Math.floor((seconds % 3600) / 60);
+		const rest = Math.floor(seconds % 60);
+		const mm = String(minutes).padStart(2, '0');
+		const ss = String(rest).padStart(2, '0');
+		return hours > 0 ? `${hours}:${mm}:${ss}` : `${minutes}:${ss}`;
+	}
+
+	/** 分辨率：取第一个有宽高的分页。 */
+	function firstResolution(list: PageInfo[]): string | null {
+		for (const page of list) {
+			if (page.width && page.height) {
+				return `${page.width}×${page.height}`;
+			}
+		}
+		return null;
+	}
+
+	$: introText = normalizeIntro(video.intro);
+	$: introLong = !!introText && (introText.length > 100 || introText.split('\n').length > 4);
+	$: staffList = normalizeStaff(video.staff);
+	$: pubtimeText = formatMoment(video.pubtime);
+	$: favtimeText = formatMoment(video.favtime);
+	$: durationText = formatDuration(pages.reduce((sum, page) => sum + (page.duration ?? 0), 0));
+	$: resolutionText = firstResolution(pages);
+
+	// ---------- 状态 ----------
+
+	function getStatusText(status: number): string {
+		if (status === 7) {
+			return '已完成';
+		} else if (status === 0) {
+			return '未开始';
+		} else {
+			return `失败${status}次`;
+		}
+	}
+
+	function getSegmentColor(status: number): string {
+		if (status === 7) {
+			return 'bg-emerald-500';
+		} else if (status === 0) {
+			return 'bg-yellow-500';
+		} else {
+			return 'bg-rose-500';
+		}
+	}
+
+	function getOverallStatus(
+		downloadStatus: number[],
+		shouldDownload: boolean,
+		valid: boolean
+	): { text: string; style: string } {
+		if (!valid) {
+			return { text: '失效', style: 'bg-gray-100 text-gray-700' };
+		}
+		if (!shouldDownload) {
+			return { text: '跳过', style: 'bg-gray-100 text-gray-700' };
+		}
+		const completed = downloadStatus.filter((status) => status === 7).length;
+		const total = downloadStatus.length;
+		const failed = downloadStatus.filter((status) => status !== 7 && status !== 0).length;
+
+		if (completed === total) {
+			return { text: '完成', style: 'bg-emerald-700 text-emerald-100' };
+		} else if (failed > 0) {
+			return { text: '失败', style: 'bg-rose-700 text-rose-100' };
+		} else {
+			return { text: '等待', style: 'bg-yellow-700 text-yellow-100' };
+		}
+	}
+
+	function getTaskName(index: number): string {
+		if (taskNames.length > 0) {
+			return taskNames[index] || `任务${index + 1}`;
+		}
+		const defaultTaskNames = ['视频封面', '视频信息', 'UP主头像', 'UP主信息', '分页下载'];
+		return defaultTaskNames[index] || `任务${index + 1}`;
+	}
+
+	$: overallStatus = getOverallStatus(video.download_status, video.should_download, video.valid);
+	$: completed = video.download_status.filter((status) => status === 7).length;
+	$: total = video.download_status.length;
+
+	function handleKeydown(event: KeyboardEvent) {
+		if (event.key === 'Escape') {
+			lightboxOpen = false;
+		}
+	}
+</script>
