+        .group_by(video::Column::Bvid)
+        .order_by_desc(Expr::col(video::Column::Id).min())
+        .into_model::<FoldedVideoGroup>()
+        .paginate(&db, page_size)
+        .fetch_page(page)
+        .await?;
+    let bvids = groups.iter().map(|group| group.bvid.clone()).collect::<Vec<String>>();
+    // 代表行要再取一次：同一 bvid 可能有多条（不同来源），按同一套筛选条件挑出要展示的那条
+    let rows = if bvids.is_empty() {
+        Vec::new()
+    } else {
+        query
+            .clone()
+            .filter(video::Column::Bvid.is_in(bvids))
+            .into_partial_model::<VideoInfo>()
+            .all(&db)
+            .await?
+    };
+    let mut videos = Vec::with_capacity(groups.len());
+    for group in groups {
+        let mut chosen: Option<&VideoInfo> = None;
+        for video_info in rows.iter().filter(|video_info| video_info.bvid == group.bvid) {
+            let better = match chosen {
+                None => true,
+                Some(current) => {
+                    let current_completed = VideoStatus::from(current.download_status).get_completed();
+                    let candidate_completed = VideoStatus::from(video_info.download_status).get_completed();
+                    // 优先挑下载完成的那条，都是同一类时挑 id 最小的
+                    (candidate_completed && !current_completed)
+                        || (candidate_completed == current_completed && video_info.id < current.id)
+                }
+            };
+            if better {
+                chosen = Some(video_info);
+            }
+        }
+        if let Some(chosen) = chosen {
+            videos.push(VideoListItem {
+                video: chosen.clone(),
+                source_count: Some(group.cnt.max(0) as usize),
+            });
+        }
+    }
+    Ok(ApiResponse::ok(VideosResponse { videos, total_count }))
 }
 
