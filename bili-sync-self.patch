+/// 判断视频是否已经下载完成（完成标记是 download_status 的最高位）
+fn is_download_completed(download_status: u32) -> bool {
+    VideoStatus::from(download_status).get_completed()
+}
+
+/// 判断视频来源是否还启用着。手动/自动下载都只看启用的来源，停用来源里的记录不该挡住别的来源
+fn is_from_enabled_source(
+    video_model: &video::Model,
+    favorite_ids: &HashSet<i32>,
+    collection_ids: &HashSet<i32>,
+    submission_ids: &HashSet<i32>,
+    watch_later_ids: &HashSet<i32>,
+) -> bool {
+    video_model.favorite_id.is_some_and(|id| favorite_ids.contains(&id))
+        || video_model.collection_id.is_some_and(|id| collection_ids.contains(&id))
+        || video_model.submission_id.is_some_and(|id| submission_ids.contains(&id))
+        || video_model
+            .watch_later_id
+            .is_some_and(|id| watch_later_ids.contains(&id))
+}
+
+/// 计算本轮应该跳过的视频 id：同一个 bvid 只下一份。
+///
+/// 判据只看 bvid（联合投稿的视频也算重复）：
+/// - 同一个 bvid 已经有一份下载完成，其余那些都不再下；
+/// - 否则只留最早入库（id 最小）的那条「要下」的记录（有效、标记为要下、来源仍启用），其余的不再下。
+///
+/// 返回的集合只用在下载候选上，不改数据库、也不影响列表与状态展示。
+pub async fn find_duplicated_video_ids(connection: &DatabaseConnection) -> Result<HashSet<i32>> {
+    let videos = video::Entity::find()
+        .filter(video::Column::Category.eq(2))
+        .all(connection)
+        .await
+        .context("query videos for deduplication failed")?;
+    let (favorites, collections, submissions, watch_laters) = tokio::try_join!(
+        favorite::Entity::find()
+            .filter(favorite::Column::Enabled.eq(true))
+            .all(connection),
+        collection::Entity::find()
+            .filter(collection::Column::Enabled.eq(true))
+            .all(connection),
+        submission::Entity::find()
+            .filter(submission::Column::Enabled.eq(true))
+            .all(connection),
+        watch_later::Entity::find()
+            .filter(watch_later::Column::Enabled.eq(true))
+            .all(connection),
+    )?;
+    let favorite_ids = favorites.into_iter().map(|model| model.id).collect::<HashSet<i32>>();
+    let collection_ids = collections.into_iter().map(|model| model.id).collect::<HashSet<i32>>();
+    let submission_ids = submissions.into_iter().map(|model| model.id).collect::<HashSet<i32>>();
+    let watch_later_ids = watch_laters.into_iter().map(|model| model.id).collect::<HashSet<i32>>();
+    let mut grouped = HashMap::<&str, Vec<&video::Model>>::new();
+    for video_model in &videos {
+        grouped.entry(video_model.bvid.as_str()).or_default().push(video_model);
+    }
+    let mut duplicated = HashSet::new();
+    for group in grouped.values() {
+        if group.len() < 2 {
+            continue;
+        }
+        if group.iter().any(|video_model| is_download_completed(video_model.download_status)) {
+            for video_model in group
+                .iter()
+                .filter(|video_model| !is_download_completed(video_model.download_status))
+            {
+                duplicated.insert(video_model.id);
+            }
+            continue;
+        }
+        let earliest = group
+            .iter()
+            .filter(|video_model| {
+                video_model.valid
+                    && video_model.should_download
+                    && is_from_enabled_source(
+                        video_model,
+                        &favorite_ids,
+                        &collection_ids,
+                        &submission_ids,
+                        &watch_later_ids,
+                    )
+            })
+            .map(|video_model| video_model.id)
+            .min();
+        if let Some(earliest) = earliest {
+            for video_model in group.iter().filter(|video_model| video_model.id != earliest) {
+                duplicated.insert(video_model.id);
+            }
+        }
+    }
+    Ok(duplicated)
+}
